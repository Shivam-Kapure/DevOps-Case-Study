# ==============================================================================
# Enterprise Payment & Notification Engine - Environment Configuration
# ==============================================================================
# Verified available local ports in high-numbered 18xxx-49xxx range:
# - Frontend: 28080
# - Backend:  28081
# (Note: Kubernetes NodePort practical uses port 30099 for frontend deployment)
# ==============================================================================

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=28081
APP_ENV=development

# Allowed CORS Origins (comma-separated or * for development)
# Allows browser running on frontend port (28080) or Kubernetes NodePort (30099)
CORS_ORIGINS=http://localhost:28080,http://127.0.0.1:28080,http://localhost:30099,*

# Frontend Service Configuration
FRONTEND_PORT=28080

# URL used by browser to reach the Backend API
# For local dev: http://localhost:28081
# For Docker Compose: http://localhost:28081 (from client browser)
# For Kubernetes: http://<NODE_IP>:<BACKEND_NODEPORT> or http://<INGRESS_HOST>
BACKEND_API_URL=http://localhost:28081
